<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HalloWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HalloWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:HalloWinUI.Views"
    Title="HalloWinUI"
    mc:Ignorable="d">


    <NavigationView 
    x:Name="NavView"
    AlwaysShowHeader="False"
    PaneDisplayMode="Left" 
    IsSettingsVisible="False"
    SelectionChanged="NavView_SelectionChanged"
    BackRequested="NavView_BackRequested">

        <!-- Modifier l'espacement de l'entête -->
        <NavigationView.Resources>
            <Thickness x:Key="NavigationViewHeaderMargin">15 0</Thickness>
        </NavigationView.Resources>

        <NavigationView.MenuItems>
            <!-- Utiliser le nom complet de la page dans la propriété Tag -->
            <NavigationViewItem 
            Tag="HalloWinUI.Views.MaisonsPage" 
            Icon="Home" 
            IsSelected="True"
            Content="Home"/>

            <NavigationViewItem 
            Tag="DemoWinUI.Views.ListeClients" 
            Content="Apps">
                <!-- Utilisation d'une icône personnalisée -->
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEB3C;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

        </NavigationView.MenuItems>

        <!--  Contiendra les pages  -->
        <Frame
        x:Name="ContentFrame"
        Navigated="ContentFrame_Navigated"
        NavigationFailed="ContentFrame_NavigationFailed" />
    </NavigationView>

</Window>
